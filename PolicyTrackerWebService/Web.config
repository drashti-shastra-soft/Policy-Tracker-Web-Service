<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<configSections>
		<section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
	</configSections>
	<appSettings>
		<!-- JWT signing key: change it before going live and keep it secret (at least 32 characters). -->
		<add key="SecretKey" value="LHtnB6iANEDNwOlSXP4jQhlAOzRVuJ5jbYm-eWDssWvFgpsyjW5Dima2JemvINb3" />
		<add key="Issuer" value="https://policytracker.local" />
		<add key="Audience" value="https://api.policytracker.local" />
		<add key="TokenExpiryHours" value="10" />
	</appSettings>
	<connectionStrings>
		<!-- Point this at your SQL Server. Windows authentication by default; for SQL login use: User ID=...;Password=... -->
		<add name="PolicyTrackerDBEntities" connectionString="Data Source=localhost\MSSQLSERVER01;Initial Catalog=PolicyTrackerDB;Integrated Security=True;TrustServerCertificate=True;MultipleActiveResultSets=True;App=PolicyTracker" providerName="System.Data.SqlClient" />
	</connectionStrings>
	<system.web>
		<compilation debug="true" targetFramework="4.8" />
		<httpRuntime targetFramework="4.8" maxRequestLength="30720" enableVersionHeader="false" />
		<globalization culture="en-IN" uiCulture="en-IN" />
	</system.web>
